{
  "name": "mahalle",
  "private": true,
  "version": "0.1.0",
  "description": "محله‌ی ما — Persian merge-2 story game for Android (Cafe Bazaar / Myket) via Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "android:sync": "npm run build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/vazirmatn": "^5.3.0"
  }
}
