{
  "name": "pishi-pixel",
  "private": true,
  "version": "1.0.0",
  "description": "Pishi Pixel – a Persian colour-shooter puzzle game for Android (Cafe Bazaar)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bake-pictures": "node scripts/bake-pictures.mjs",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@twemoji/svg": "^15.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
