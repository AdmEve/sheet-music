{
  "name": "sheet-music",
  "private": true,
  "version": "0.1.0",
  "description": "Offline piano + cello audio-to-sheet-music transcriber (web + Android)",
  "type": "module",
  "scripts": {
    "copy-model": "node scripts/copy-model.mjs",
    "dev": "npm run copy-model && vite",
    "build": "npm run copy-model && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.8.1",
    "verovio": "^6.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
